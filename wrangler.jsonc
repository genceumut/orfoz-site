{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker's name in the Cloudflare dashboard (Workers Builds).
  "name": "orfoz-site",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Only these paths run the Worker (Basic Auth). Everything else is served
    // directly as static assets.
    "run_worker_first": ["/diegetic", "/diegetic/*"]
  }
  // DIEGETIC_USER and DIEGETIC_PASSWORD are set as secrets in the dashboard
  // (Settings → Variables and Secrets), never here.
}
