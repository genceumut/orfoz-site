{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker's name in the Cloudflare dashboard (Workers Builds).
  "name": "orfoz-site",
  "compatibility_date": "2026-09-01",
  // Static site only: every path is served straight from the Astro build.
  "assets": {
    "directory": "./dist"
  }
}
