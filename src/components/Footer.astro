---
interface Props {
  name: string;
  line: string;
  note?: string;
  year: number;
}

const { name, line, note, year } = Astro.props;
---

<footer class="footer">
  <div class="wrap row">
    <p><span class="wordmark">{name.toLowerCase()}</span> · {line}</p>
    {note && <p class="note">{note}</p>}
    <p>© {year} {name}</p>
  </div>
</footer>

<style>
  .footer {
    padding-block: 40px 48px;
    font-size: 0.88rem;
    color: var(--ink-2);
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 32px;
    justify-content: space-between;
    align-items: baseline;
  }
  .wordmark {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--ink);
  }
  .note {
    color: var(--muted);
  }
</style>
