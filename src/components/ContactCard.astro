---
// The accent-colored closing card with a single mailto link. Body copy goes in the slot.
interface Props {
  id?: string;
  heading: string;
  href: string;
  label: string;
}

const { id = 'contact', heading, href, label } = Astro.props;
---

<section id={id} class="section" aria-labelledby={`${id}-title`}>
  <div class="wrap">
    <div class="contact-card">
      <div class="body">
        <h2 id={`${id}-title`}>{heading}</h2>
        <slot />
      </div>
      <div class="action">
        <a class="btn mail" href={href}>{label}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-card {
    background: var(--accent);
    color: var(--accent-ink);
    border-radius: 28px;
    padding: clamp(32px, 6vw, 64px);
    display: grid;
    gap: 28px;
    align-items: center;
  }
  @media (min-width: 860px) {
    .contact-card {
      grid-template-columns: 1.4fr 1fr;
      gap: 48px;
    }
    .action {
      justify-self: end;
    }
  }
  h2 {
    margin-bottom: 14px;
  }
  .body :global(p) {
    max-width: 52ch;
    opacity: 0.95;
  }
  .mail {
    background: var(--ink);
    color: var(--bg);
    word-break: break-all;
    text-align: center;
  }
  .mail:focus-visible {
    outline-color: var(--accent-ink);
  }
</style>
