---
// Renders the app list from src/data/apps.ts, in order. Apps with a `mock` are shown
// beside their live mock.
import { apps, type AppMock, type StudioApp } from '../../data/apps';
import YarunMock from './mocks/YarunMock.astro';
import CayMock from './mocks/CayMock.astro';

const mocks: Record<AppMock, typeof YarunMock> = { yarun: YarunMock, cay: CayMock };

const meta = (a: StudioApp) => [
  { term: 'Platform', detail: a.platform },
  { term: 'Status', detail: a.status },
  { term: 'Price', detail: a.price },
];
---

<section id="apps" class="section apps" aria-labelledby="apps-title">
  <div class="wrap">
    <div class="section-head">
      <div>
        <p class="eyebrow">The apps</p>
        <h2 id="apps-title">What we’re making<span class="dot">.</span></h2>
      </div>
      <p class="lede">Nothing is released yet. Here’s what we’re working on.</p>
    </div>

    <div class="featured">
      {
        apps.map((a) => {
          const Mock = a.mock ? mocks[a.mock] : null;
          return (
            <article id={a.id} class:list={['feature', { 'no-mock': !Mock }]} aria-labelledby={`${a.id}-name`}>
              {Mock && <Mock appName={a.name} />}
              <div class="info">
                <p class:list={['status', a.status === 'Idea' ? 'idea' : 'dev']}>{a.status}</p>
                <h3 id={`${a.id}-name`}>{a.name}</h3>
                {a.tagline && <p class="tagline">{a.tagline}</p>}
                <p class="desc">{a.description}</p>
                {a.points && (
                  <ul class="points">
                    {a.points.map((p) => (
                      <li>{p}</li>
                    ))}
                  </ul>
                )}
                <dl class="meta">
                  {meta(a).map((m) => (
                    <div>
                      <dt>{m.term}</dt>
                      <dd>{m.detail}</dd>
                    </div>
                  ))}
                </dl>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .apps {
    background: var(--surface-2);
  }

  .featured {
    display: grid;
    gap: clamp(64px, 9vw, 112px);
  }
  .feature {
    display: grid;
    gap: 40px;
    align-items: center;
  }
  @media (min-width: 900px) {
    .feature {
      grid-template-columns: minmax(0, 400px) 1fr;
      gap: 80px;
    }
    .feature:nth-child(even) {
      grid-template-columns: 1fr minmax(0, 400px);
    }
    .feature:nth-child(even) .info {
      order: -1;
    }
    .feature.no-mock {
      grid-template-columns: 1fr;
    }
  }

  .status {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 999px;
    margin-bottom: 14px;
  }
  .status.dev {
    background: var(--tint);
    color: var(--ink);
  }
  .status.idea {
    border: 1.5px dashed var(--line);
    color: var(--ink-2);
  }

  .info h3 {
    font-size: clamp(1.8rem, 3.4vw, 2.4rem);
  }
  .tagline {
    margin-top: 6px;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.25rem;
    color: var(--accent);
  }
  .desc {
    margin-top: 14px;
    color: var(--ink-2);
    max-width: 52ch;
  }
  .points {
    list-style: none;
    margin: 20px 0 0;
    padding: 0;
    max-width: 56ch;
  }
  .points li {
    position: relative;
    padding: 10px 0 10px 24px;
    border-top: 1px solid var(--line);
  }
  .points li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 21px;
    width: 10px;
    height: 2px;
    background: var(--accent);
  }

  .meta {
    margin: 22px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
  }
  .meta dt {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
  }
  .meta dd {
    margin: 2px 0 0;
    font-weight: 500;
    font-size: 0.95rem;
  }
</style>
