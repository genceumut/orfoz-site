---
// The studio site. Must not link to /diegetic or mention it.
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/studio/Hero.astro';
import Why from '../components/studio/Why.astro';
import HowWeBuild from '../components/studio/HowWeBuild.astro';
import Apps from '../components/studio/Apps.astro';
import Contact from '../components/studio/Contact.astro';
import { brand } from '../config/studio';
---

<Base title={brand.name} description={brand.description} siteName={brand.name} url={brand.url}>
  <Header
    name={brand.name}
    home="/"
    nav={[
      { href: '#why', label: 'Why' },
      { href: '#how', label: 'How we build' },
      { href: '#apps', label: 'Apps' },
    ]}
    cta={{ href: '#contact', label: 'Contact' }}
  />
  <main id="main">
    <Hero />
    <Why />
    <HowWeBuild />
    <Apps />
    <Contact />
  </main>
  <Footer name={brand.name} line={brand.tagline} year={brand.year} />
</Base>
